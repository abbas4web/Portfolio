datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  ADMIN
}

model AdminUser {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  fullName      String
  role          Role           @default(ADMIN)
  isActive      Boolean        @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]
  mediaUploads  Media[]

  @@map("admin_users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  revoked   Boolean   @default(false)
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model SiteProfile {
  id              String           @id @default(uuid())
  fullName        String
  title           String
  headline        String?
  shortBio        String?
  fullBio         String?
  email           String
  phone           String?
  location        String?
  avatarUrl       String?
  avatarAlt       String?          @default("Profile Avatar")
  metaTitle       String?
  metaDescription String?
  isPublished     Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  socialLinks     SocialLink[]
  resumes         Resume[]
  aboutHighlights AboutHighlight[]

  @@map("site_profiles")
}

model NavigationItem {
  id           String   @id @default(uuid())
  label        String
  href         String
  target       String?  @default("_self")
  visible      Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([visible, displayOrder])
  @@map("navigation_items")
}

model AboutHighlight {
  id           String      @id @default(uuid())
  profileId    String
  profile      SiteProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title        String
  subtitle     String?
  iconKey      String?
  displayOrder Int         @default(0)
  published    Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([profileId, displayOrder])
  @@map("about_highlights")
}

model Service {
  id            String         @id @default(uuid())
  title         String
  slug          String         @unique
  iconKey       String
  description   String
  displayOrder  Int            @default(0)
  published     Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  skillCategory SkillCategory?

  @@index([published, displayOrder])
  @@map("services")
}

model SkillCategory {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  description  String?
  serviceId    String?  @unique
  service      Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  displayOrder Int      @default(0)
  published    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  skills       Skill[]

  @@index([published, displayOrder])
  @@map("skill_categories")
}

model Skill {
  id           String        @id @default(uuid())
  categoryId   String
  category     SkillCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name         String
  level        Int?
  iconKey      String?
  displayOrder Int           @default(0)
  published    Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([categoryId, displayOrder])
  @@map("skills")
}

model Experience {
  id           String    @id @default(uuid())
  company      String
  role         String
  location     String?
  startDate    DateTime
  endDate      DateTime?
  current      Boolean   @default(false)
  description  String
  technologies String[]
  companyUrl   String?
  displayOrder Int       @default(0)
  published    Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([published, displayOrder])
  @@map("experiences")
}

model Education {
  id           String    @id @default(uuid())
  institution  String
  degree       String
  fieldOfStudy String?
  location     String?
  startDate    DateTime
  endDate      DateTime?
  current      Boolean   @default(false)
  description  String?
  grade        String?
  displayOrder Int       @default(0)
  published    Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([published, displayOrder])
  @@map("educations")
}

model Project {
  id               String   @id @default(uuid())
  title            String
  slug             String   @unique
  shortDescription String?
  description      String
  image            String
  imageAlt         String?  @default("Project thumbnail")
  technologies     String[]
  githubUrl        String?
  liveUrl          String?
  featured         Boolean  @default(false)
  published        Boolean  @default(true)
  displayOrder     Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([published, displayOrder])
  @@index([featured, published])
  @@map("projects")
}

enum ExperimentStatus {
  IN_DEVELOPMENT
  LIVE
  ARCHIVED
}

model AILabExperiment {
  id           String           @id @default(uuid())
  title        String
  slug         String           @unique
  summary      String
  architecture String?
  modelUsed    String
  demoUrl      String?
  codeUrl      String?
  status       ExperimentStatus @default(LIVE)
  published    Boolean          @default(true)
  displayOrder Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([published, displayOrder])
  @@map("ai_lab_experiments")
}

model SocialLink {
  id           String       @id @default(uuid())
  profileId    String?
  profile      SiteProfile? @relation(fields: [profileId], references: [id], onDelete: Cascade)
  platform     String
  url          String
  iconKey      String
  displayOrder Int          @default(0)
  published    Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([published, displayOrder])
  @@map("social_links")
}

model Resume {
  id            String       @id @default(uuid())
  profileId     String?
  profile       SiteProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  title         String
  fileUrl       String
  version       String?
  isCurrent     Boolean      @default(true)
  downloadCount Int          @default(0)
  published     Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([isCurrent, published])
  @@map("resumes")
}

enum MessageStatus {
  UNREAD
  READ
  ARCHIVED
  SPAM
}

model ContactMessage {
  id        String        @id @default(uuid())
  name      String
  contact   String
  subject   String?
  message   String
  status    MessageStatus @default(UNREAD)
  ipAddress String?
  userAgent String?
  repliedAt DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, createdAt])
  @@map("contact_messages")
}

model Media {
  id           String     @id @default(uuid())
  filename     String
  originalName String
  mimeType     String
  sizeBytes    Int
  url          String
  path         String
  altText      String?
  uploadedById String?
  uploadedBy   AdminUser? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([createdAt])
  @@map("media")
}
